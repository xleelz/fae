      ],
      "note": "truth table; Schedule.Due admits anchored occurrences before the exclusive end"
    },
    "firing": {
      "mutation": {
        "original": "return active && due && beforeEnd && pinned",
        "weakened": "return active && due && pinned"
      },
      "refusal_tests": [
        "TestCanAdmit",
        "TestBoundedCatchUpAndPause"
      ]
    },
    "native": {
      "tests": [
        "TestCronLifecycleAndRoundBound",
        "TestCronPinningCatchUpAndRestart"
      ],
      "path": "Start -> Schedule RPC create/pause/retire; d.dispatchCrons (called directly under d.mu) -> cron.Schedule.Due -> CanAdmit; paused/retired schedules admit nothing, ended schedule completes"
    },
    "status": "native-evidenced",
    "limits": "Predicate over derived booleans; cron remains Local-only per TESTING.md. Requirement mapping is limited to the named predicate and cited tests; no complete requirement acceptance is claimed."
  },
