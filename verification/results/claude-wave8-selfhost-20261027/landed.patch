+// FAE-HOST-005: a reading held for pressure records the avg60 PSI values and
+// the direction of each avg10 and avg60 series in its waiting line.
+func TestHeavyAdmissionPressureWaitRecordsAvg60AndDirection(t *testing.T) {
+	policy := hostguard.DefaultPolicy()
+	a, _, alerts, _ := admissionFixture(t, hostSample(64, 1, 0, 4.5))
+	a.Class, a.MemoryFloor, a.Slice = "role", -1, policy.Interval
+	a.HostChecks = max(policy.Checks, 2)
+	var timeout *AdmissionTimeout
+	if _, e := a.Acquire(context.Background(), "avg60"); !errors.As(e, &timeout) || timeout.Stage != "pressure" {
+		t.Fatal(e)
+	}
+	line := ""
+	for _, l := range *alerts {
+		if strings.Contains(l, "gate waiting stage=pressure") {
+			line = l
+			break
+		}
+	}
+	if line == "" {
+		t.Fatal("no pressure waiting line", *alerts)
+	}
+	for _, name := range []string{"io_full_avg60", "memory_full_avg60", "io_avg10_dir", "io_avg60_dir", "memory_avg10_dir", "memory_avg60_dir"} {
+		if !strings.Contains(line, name+"=") {
+			t.Fatalf("pressure waiting line lacks %s: %s", name, line)
+		}
+	}
+}
+
 // FAE-HOST-001: pressure seen under the granted lease releases it and returns
 // to the bounded host wait; the lease is never held through a back-off.
